new file mode 100644
index 0000000..3ee1ff6
--- /dev/null
+++ b/src/lib/ControlMapLayout.h
@@ -0,0 +1,22 @@
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace BTPS::ControlMapLayout {
+using Version = std::array<std::uint16_t, 4>;
+
+constexpr std::ptrdiff_t EnabledOffset(bool ae, Version version) noexcept
+{
+    // The full version matters: 1.7.104 is newer than 1.6.1130 despite 104<1130.
+    // On post-1130 AE, 0x118 is contextPriorityStack.size(), NOT control flags.
+    return ae && version >= Version{1, 6, 1130, 0} ? 0x120 : 0x118;
+}
+
+inline std::uint32_t* EnabledPointer(void* controlMap, bool ae, Version version) noexcept
+{
+    if (!controlMap) return nullptr;
+    return reinterpret_cast<std::uint32_t*>(
+        static_cast<std::byte*>(controlMap) + EnabledOffset(ae, version));
+}
+}
