{
  "$schema": "https://raw.githubusercontent.com/Exit-9B/InventoryInjector/main/docs/InventoryInjector.schema.json",
  "rules": [
    {
      "match": {
        "formType": "MiscItem",
        "formId": {
          "anyOf": [
            "exchangeCurrency_enhanced.esp|b6d",
            "update.esm|de5021",
            "update.esm|de5024",
            "update.esm|de5029",
            "exchangeCurrency_patch_COIN.esp|871",
